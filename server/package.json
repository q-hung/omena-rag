{
  "name": "server",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26" },
  "scripts": {
    "dev": "pnpm build && pnpm run --parallel \"/^dev:/\"",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:api": "node --watch --enable-source-maps dist/src/api.js",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "db:migrate": "node --enable-source-maps dist/src/db/migrate.js",
    "seed": "node --enable-source-maps dist/scripts/seed.js",
    "start": "node --enable-source-maps dist/src/api.js",
    "worker": "node --enable-source-maps dist/src/worker.js",
    "eval": "node --enable-source-maps dist/eval/run.js",
    "eval:rfp": "node --enable-source-maps dist/eval/rfp-run.js",
    "rfp:feedback": "node --enable-source-maps dist/scripts/rfp-feedback.js",
    "smoke-embed": "node --enable-source-maps dist/scripts/smoke-embed.js"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "csv-parse": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@google/genai": "^2.26.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "luxon": "3.7.2",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
