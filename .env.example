# Copy to .env. See server/src/config.ts for the full schema.

DATABASE_URL=postgres://omena:omena@localhost:5433/omena
TEST_DATABASE_URL=postgres://omena:omena@localhost:5433/omena_test
PORT=8080

# stub: deterministic embeddings and scripted answers, UI shows SIMULATED AI.
# gemini: real calls; GEMINI_API_KEY is then required.
LLM_PROVIDER=stub
# GEMINI_API_KEY=
GENERATION_MODEL=gemini-3.1-flash-lite
# Required for `pnpm eval --judge`; must differ from GENERATION_MODEL.
JUDGE_MODEL=gemini-3-flash-preview
JUDGE_PROMPT_VERSION=v1
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# USD per million tokens.
PRICE_GENERATION_INPUT_USD_PER_MTOK=0.25
PRICE_GENERATION_OUTPUT_USD_PER_MTOK=1.50
PRICE_EMBEDDING_INPUT_USD_PER_MTOK=0.15

RETRIEVAL_MODE=vector
RETRIEVAL_MIN_SCORE=0.5
DAILY_BUDGET_USD=5

# false for plain-HTTP local development.
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:5173
SESSION_HOURS=12

# Local debugging only (SEC-11 exception): write every raw Gemini request and
# response to JSON files in this directory. Needs COOKIE_SECURE=false.
# LLM_DEBUG_DIR=.llm-debug

SEED_EMPLOYEE_PASSWORD=omena-demo
